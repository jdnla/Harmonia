# avr-tv-bridge configuration — copy to ~/.config/avr-tv-bridge/config.env
# and fill in. The installer does this for you on first run.

# --- MQTT broker (Home Assistant's broker) ---
MQTT_HOST=mqtt.example
MQTT_PORT=1883
MQTT_USER=avrbridge
MQTT_PASS=change-me

# --- Devices ---
DENON_HOST=denon.example
VIZIO_HOST=vizio.example
VIZIO_TOKEN_FILE=%h/.config/avr-tv-bridge/vizio.token

# --- Home Assistant display names (rename anytime) ---
DENON_NAME=Denon X1800H
VIZIO_NAME=Vizio P65

# Cosmetic: offset so HA's volume matches the number on the receiver's on-screen
# display (the control protocol and the on-screen number can differ). Added on
# read, subtracted on write. e.g. set 45 in HA showed 47 on screen => offset 2.
DENON_VOLUME_OFFSET=0

# --- "Media Center On" scene: power both on and select these inputs ---
SCENE_AVR_INPUT=MPLAY
# SCENE_TV_INPUT is the FALLBACK TV input. The bridge auto-detects the real
# input by matching the receiver's CEC name in the TV's input list (so it
# follows the physical HDMI wiring, not a hardcoded port) and only uses this
# value when detection is unavailable/ambiguous. Set it to wherever the chain
# is actually plugged in as a safe default.
SCENE_TV_INPUT=HDMI-1
# Optional: friendly-name substring(s) (comma-separated) identifying the
# media-center TV input in the SmartCast input list, e.g. the receiver's CEC
# name "AVR-X1800H". Leave empty to auto-derive from the receiver's model/name.
# SCENE_TV_INPUT_MATCH=AVR-X1800H
# Scene timing: the scene waits for each device to report power=ON (up to
# SCENE_POWER_TIMEOUT, polling every SCENE_POLL_INTERVAL) before switching its
# input, then verifies/retries the input change (waiting SCENE_INPUT_SETTLE
# between tries). Increase the timeout if a device is slow to wake from standby.
SCENE_POWER_TIMEOUT=15
SCENE_POLL_INTERVAL=1.0
SCENE_INPUT_SETTLE=1.5

# --- Power-sync watchdog ---
# Keeps the AVR's power in sync with the TV (TV is the source of truth:
# TV on => AVR on, TV off => AVR off). Corrects CEC commands that reach only one
# device. NOTE: with this on, turning OFF just the AVR while the TV is on will be
# reverted (the AVR is brought back on to match the TV). Set SYNC_POWER=0 if you
# want to run the TV with the AVR off (e.g. TV speakers).
SYNC_POWER=1
# Mismatch must persist this many consecutive polls before correcting (avoids
# reacting to power-up transients).
SYNC_PERSIST_POLLS=2
# After any bridge power command/scene, don't auto-correct for this many seconds
# (so the watchdog doesn't fight its own actions while devices settle).
SYNC_SUPPRESS_SECS=30

# --- Capabilities ---
# TV speakers routed to the AVR => TV exposes only power+input (no dead volume).
# If you use the TV's own speakers, set: VIZIO_CAPS=power,volume,mute,input
VIZIO_CAPS=power,input
# Read-only SmartCast diagnostics (firmware/audio/ad/input visibility) poll
# interval in seconds. Set 0 to disable the extra polling.
VIZIO_PROFILE_INTERVAL=60

# --- Input option lists shown in Home Assistant (comma-separated) ---
# Denon source codes: MPLAY=Media Player, SAT/CBL, DVD, BD, GAME, AUX1, TV,
#   TUNER, CD, NET (HEOS/network), BT (bluetooth)
DENON_INPUTS=MPLAY,SAT/CBL,DVD,BD,GAME,AUX1,TV,TUNER,CD,NET,BT
VIZIO_INPUTS=HDMI-1,HDMI-2,HDMI-3,HDMI-4,COMP,TUNER,CAST,SMARTCAST

# --- Camera auto-popup (optional) ---
# Rendered as a Wayland layer-shell overlay (QML via qml6 + QtMultimedia +
# org.kde.layershell) so it floats in a corner above fullscreen apps without
# stealing focus, and works under Plasma Bigscreen. install-launcher.sh pulls
# the qml6/layer-shell-qt/qtmultimedia packages.
# Pops up a small always-on-top video overlay when a detection-count MQTT topic
# goes above zero (e.g. Frigate person detection), and closes it a grace period
# after the count returns to zero. DISABLED unless both STREAM_URL and
# TRIGGER_TOPIC are set. Also exposes an on/off toggle in Home Assistant.
#
# Trigger topic + mode:
#   CAM_POPUP_TRIGGER_MODE=count  (default): payload is an integer count (or
#     ON/OFF). e.g. Frigate zone occupancy  frigate/<cam>/<zone>/person.
#   CAM_POPUP_TRIGGER_MODE=frigate_review: payload is a Frigate `frigate/reviews`
#     JSON event; opens on an ALERT for CAM_POPUP_FRIGATE_CAMERA and closes when
#     it ends. Alerts are already zone-scoped by your Frigate review config
#     (required_zones), so this is the cleanest "someone actually approaching"
#     trigger — no popup for people passing through unrelated parts of the view.
CAM_POPUP_TRIGGER_TOPIC=
CAM_POPUP_TRIGGER_MODE=count
# For frigate_review mode: which camera's alerts to react to, and which severity.
CAM_POPUP_FRIGATE_CAMERA=
CAM_POPUP_FRIGATE_SEVERITY=alert
# Stream URL: anything QtMultimedia/ffmpeg can play. A go2rtc HTTP endpoint
#   avoids embedding camera credentials, e.g.
#   http://<go2rtc-host>:1984/api/stream.mp4?src=<name>  (prefer a low-res "sub"
#   /h264 stream — a 4K HEVC main stream glitches when joined mid-GOP).
CAM_POPUP_STREAM_URL=
# Instant still-frame placeholder shown while the live video connects (the
# h264 stream takes ~3-5s to first frame; a JPEG loads in ~0.1s, killing the
# black startup gap). A Frigate latest.jpg or go2rtc frame.jpeg works. Empty
# => start black. e.g. http://<frigate>:5000/api/<cam>/latest.jpg
CAM_POPUP_SNAPSHOT_URL=
# ffmpeg stream-probe size (bytes) for the video player — smaller commits to
# decoding sooner (~0.7s faster first frame on the fragmented mp4). 4096 is a
# good low value; 0 keeps the default. (Note: QtMultimedia can't reach the
# instant RTSP-UDP path, so ~2.3s is the floor here; the snapshot hides it.)
CAM_POPUP_PROBE_SIZE=4096
CAM_POPUP_TITLE=Camera
CAM_POPUP_GRACE_SECS=10
# Window size in screen pixels + which corner (top-right/top-left/bottom-right/
# bottom-left) and edge margin.
CAM_POPUP_WIDTH=640
CAM_POPUP_HEIGHT=360
CAM_POPUP_CORNER=top-right
CAM_POPUP_MARGIN=16
# (Legacy/no-op) decode hint kept for compatibility; the current QtMultimedia
# layer-shell player picks its own decode path. Safe to ignore.
CAM_POPUP_HWDEC=no
# Entrance/exit animation: "slide" (default — slides in from the nearest screen
# edge like a notification, and back out on close), "fade", or "none".
# CAM_POPUP_ANIM_MS is the animation duration in ms.
CAM_POPUP_ANIM=slide
CAM_POPUP_ANIM_MS=260
# Screen size for corner placement (logical px; match your display).
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080

# --- Tuning ---
POLL_INTERVAL=10
LOG_LEVEL=INFO

# --- Inactivity auto power-off (optional) ---
# After IDLE_OFF_TIMEOUT seconds of NO input (mouse/keyboard/remote — via
# swayidle + the Wayland idle protocol) AND nothing playing (playerctl/MPRIS),
# show an on-screen warning for IDLE_OFF_WARN seconds, then fire the "Media
# Center Off" scene (TV off, then AVR off). The PC stays on. The remote D-pad
# counts as input automatically (cec_nav injects real key events). HA exposes an
# "Auto Power-Off (idle)" toggle AND an "Auto Power-Off Timeout" number (minutes)
# to change IDLE_OFF_TIMEOUT at runtime — IDLE_OFF_TIMEOUT here is just the
# startup default (runtime changes are not persisted back to this file).
IDLE_OFF_ENABLE=1
# IDLE_OFF_TIMEOUT is the FULL ("in use") timeout. With IDLE_OFF_ADAPTIVE=1 the
# system powers off after the SHORT window (IDLE_OFF_SHORT_TIMEOUT) when it's
# freshly powered on but UNUSED; the first real input — local remote/keyboard OR
# a control sent from HA/phone (both seen as input) — extends it to the full
# IDLE_OFF_TIMEOUT for the rest of that session. After it powers off it resets to
# the short window for next time. Set IDLE_OFF_ADAPTIVE=0 for a single fixed
# IDLE_OFF_TIMEOUT. (Media playback defers power-off regardless.) The HA
# "Auto Power-Off Timeout" number adjusts the FULL timeout.
IDLE_OFF_TIMEOUT=1800
IDLE_OFF_SHORT_TIMEOUT=300
IDLE_OFF_ADAPTIVE=1
IDLE_OFF_WARN=60

# --- Attention chime (optional) ---
# A soft sound played on the AVR to gently get someone's attention, triggered by
# an HA dashboard button (topic avr-tv-bridge/chime/set). Plays CHIME_REPEAT
# times with a CHIME_GAP_MS gap (default ~4s total) then stops; pressing again
# restarts it. If the amp is OFF when it fires, it's powered on and routed to
# CHIME_AMP_INPUT (so the sound is heard) and LEFT ON afterward.
CHIME_ENABLE=1
# Any sound file paplay can play; the freedesktop set lives in
# /usr/share/sounds/freedesktop/stereo/ (complete.oga, bell.oga, message.oga...).
CHIME_SOUND=/usr/share/sounds/freedesktop/stereo/complete.oga
CHIME_REPEAT=3
CHIME_GAP_MS=400
# Playback stream volume 0..65536 (65536=100%). Lower = softer chime. This is
# the chime's own stream level and does NOT change the AVR/system volume.
CHIME_VOLUME=32768
# Wake the amp if it's off (1) or only chime when it's already on (0).
CHIME_AMP_ON=1
# Input to select when waking the amp (defaults to SCENE_AVR_INPUT so the PC's
# audio is routed). CHIME_AMP_WAIT = max seconds to wait for the amp to CONFIRM
# power=ON (polled over telnet, returns as soon as it's up). CHIME_AMP_SETTLE =
# extra pause after that for the HDMI audio link to lock, so the first notes
# aren't swallowed while it's still waking/switching inputs.
CHIME_AMP_INPUT=MPLAY
CHIME_AMP_WAIT=8.0
CHIME_AMP_SETTLE=4.0
# On a cold amp-wake the Denon reports power=ON before its HDMI audio actually
# passes sound; CHIME_COLD_EXTRA_REPEAT adds repeats so some of the chime lands
# once audio is flowing. CHIME_IDLE_DEFER suppresses idle auto-off for N seconds
# after a chime so a ping never cascades into a power-off (the amp returns to
# standby on its own via the power-sync watchdog if the TV stays off).
CHIME_COLD_EXTRA_REPEAT=2
CHIME_IDLE_DEFER=180
# Output sink (blank = default sink, which is the HDMI output to the AVR) +
# player binary. CHIME_SINK only applies to paplay.
CHIME_SINK=
CHIME_PLAYER=paplay

# --- AVR channel-sync (optional) ---
# Match the PC's HDMI output channel layout to the receiver so real 5.1/7.1
# content isn't downmixed to stereo before it leaves the PC. The launcher polls
# the sound card's HDMI profile availability (driven by the AVR's EDID) and
# selects the richest surround profile when the receiver is present, falling back
# to stereo when it's off. Pairs with the WirePlumber upmix drop-in
# (51-hdmi-upmix.conf) so stereo content still fills every speaker. HA exposes an
# "AVR Channel Sync" toggle. Requires PipeWire/pactl in the user session.
CHANNEL_SYNC_ENABLE=1
# Poll interval (seconds) for EDID/profile availability changes.
CHANNEL_SYNC_POLL=15
# Substring used to find the HDMI sound card in `pactl list cards short`.
CHANNEL_SYNC_CARD_HINT=hdmi
# Prefer discrete surround (1). Set 0 to always force stereo and let the AVR do
# its own upmix (the pre-channel-sync behavior).
CHANNEL_SYNC_PREFER_SURROUND=1
# Also require the Denon to report power=ON (telnet) before asserting surround.
# Off by default — EDID availability alone is reliable. Needs DENON_HOST set.
CHANNEL_SYNC_DENON_CHECK=0
# Max channels your speaker layout can use — caps the profile the sync targets:
#   2 = stereo / TV-direct (never selects surround)
#   6 = 5.1  (FL FR C LFE SL SR)
#   8 = 7.1  (adds SBL SBR)   <- default (no cap)
# A layout without a center/sub still uses the standard profile; the receiver
# folds the phantom center to the front L/R (as this setup does: 6 real speakers,
# no center/sub, driven by the 7.1 profile). Set to match YOUR speaker count.
SPEAKER_CHANNELS=8

# --- D-pad / OK navigation input source ---
# How the remote's D-pad + OK/Back reach the host:
#   cec (default): the TV forwards D-pad/OK/Back over HDMI-CEC; the cecnav
#     service reads /dev/cec0 and injects keystrokes. CEC decodes cleanly and
#     needs no per-remote IR config. Requires the TV to do CEC passthrough and
#     the user in the `video` group.
#   ir: read the D-pad/OK/Back from the IR remote via lircd/irexec instead, and
#     IGNORE CEC for nav (the cecnav service is disabled). Use this if your TV
#     doesn't forward nav over CEC, if CEC nav is laggy, or with a different
#     remote/TV. Requires the D-pad/OK/Back keys in your lirc remote config
#     (src/drivers/vizio/lirc/vizio.lircd.conf: KEY_UP/DOWN/LEFT/RIGHT/OK/BACK).
# NOTE: don't run both at once — the Vizio forwards BOTH CEC and IR per press,
# so enabling IR nav while cecnav runs double-fires. install-launcher.sh
# enforces one or the other based on this setting.
NAV_MODE=cec
# RECOMMENDATION: cec is preferred. IR nav on some remotes/receivers (e.g.
# a USB-UIRT in raw mode) can mis-decode NEC repeat frames as phantom
# presses of nearby buttons (~110-185ms after a real press), causing
# double/cross-button ghosting that no debounce fully eliminates. Use ir
# only if CEC passthrough is unavailable, and expect to tune
# NAVKEY_DEBOUNCE_MS / NAVKEY_GLOBAL_MS.

# --- Per-app D-pad navigation profiles ---
# Most launched apps (Plex, the Chrome web-apps) implement arrow-key spatial
# navigation, so the D-pad's Up/Down/Left/Right just work. Some apps don't:
# IPTVnator (Electron/Angular) has views with no arrow-key nav but honors
# Chromium Tab / Shift+Tab focus traversal. nav_profiles.py maps the D-pad onto
# the keys such an app actually understands, selected by the FOCUSED window's
# class. Apps with no profile are untouched (default arrow keys). Only the CEC
# nav path consults profiles (the live nav path); the IR path does not.
#   NAV_PROFILES=1        enable per-app profiles (default; 0 to disable)
#   NAV_FOCUS_CACHE_MS    how long to cache the focused-window class between
#                         kdotool queries (default 400ms) — lower = snappier
#                         app switching, higher = fewer kdotool calls under
#                         rapid scrolling.
# Built-in profile: iptvnator (Down/Right->Tab, Up/Left->Shift+Tab, OK->Enter,
# Back->Esc). Add more in src/nav_profiles.py PROFILES.
NAV_PROFILES=1
NAV_FOCUS_CACHE_MS=400

# --- Plex 'now playing' source (optional, for richer media state) ---
# The snap Plex HTPC exposes NO MPRIS, so MPRIS can't tell us what Plex is
# playing. If you point these at your Plex Media Server, the bridge queries its
# REST API (/status/sessions) for the REAL episode/movie title, poster art, and
# live position whenever Plex is the active player — far richer than MPRIS. When
# Plex isn't playing, the bridge falls back to MPRIS (Netflix/Chrome apps).
# Leave PLEX_BASE_URL/PLEX_TOKEN empty to disable (MPRIS-only).
#   PLEX_BASE_URL     your PMS, e.g. http://plex.example:32400
#   PLEX_TOKEN        an X-Plex-Token for the server (SECRET — keep in config.env,
#                     never commit). Get one from Plex Web (Get Info > View XML)
#                     or from the app logs.
#   PLEX_PLAYER_ADDRESS  LAN IP of THIS HTPC's Plex client, so the bridge picks
#                     this host's playback session out of all sessions. Default:
#                     auto-detect this host's primary IP. Set if auto is wrong.
#   PLEX_MACHINE_ID   optional: match this host's client by its machineIdentifier instead
#                     of IP (more robust if the IP changes).
PLEX_BASE_URL=
PLEX_TOKEN=
PLEX_PLAYER_ADDRESS=
PLEX_MACHINE_ID=

# --- Home Assistant notification toasts (optional) ---
# Bigscreen has no notification server, so the launcher renders its own layer-shell toast
# in a screen corner when HA publishes to NOTIFY_TOPIC. Payload is JSON:
#   {"title":"Doorbell","body":"Someone at the door",
#    "image":"http://homeassistant:8123/local/snap.jpg","timeout":8}
# (a bare string payload is treated as the body; timeout is seconds).
NOTIFY_TOPIC=avr-tv-bridge/notify
NOTIFY_WIDTH=560
NOTIFY_HEIGHT=150
NOTIFY_CORNER=top-left
NOTIFY_MARGIN=16
NOTIFY_TIMEOUT=8
NOTIFY_ANIM_MS=260
# Appearance (Breeze-ish defaults). Any of these can also be overridden
# per-notification by including the same key in the JSON payload (e.g.
# {"accent":"#2ecc71", "timeout":5, "title_size":28}).
NOTIFY_ACCENT=#3daee9
NOTIFY_BG=#ee1b1e20
NOTIFY_TITLE_COLOR=#ffffff
NOTIFY_BODY_COLOR=#c8ccd0
NOTIFY_RADIUS=12
NOTIFY_TITLE_SIZE=24
NOTIFY_BODY_SIZE=18
NOTIFY_FONT=Noto Sans
NOTIFY_PROGRESS=1
NOTIFY_SHADOW=1

# ---------------------------------------------------------------------------
# IR bridge (avr-tv-bridge-ir.service — USB-UIRT via LIRC)
# ---------------------------------------------------------------------------
# Exposes the IR transceiver to Home Assistant: RECEIVE decoded presses (as an
# HA event entity + "Last IR Code" sensor), SEND known codes (per-key buttons +
# a generic "IR Send (Remote/KEY)" box), and LEARN new codes ("IR Learn
# (Remote/KEY)" — then press the physical remote at the receiver). All of these
# have sensible defaults; override only if your hardware differs.
#
# Serial device + LIRC driver for the USB-UIRT (see lirc_options.conf).
UIRT_DEVICE=/dev/serial/by-id/usb-FTDI_USB-UIRT-if00-port0
UIRT_DRIVER=usb_uirt_raw
# lircd control socket (where decoded presses are read and irsend connects).
LIRC_SOCKET=/var/run/lirc/lircd
# Seconds to wait for a button press during a learn before giving up.
IR_LEARN_TIMEOUT=20
# 1 = auto-create a tap-to-send HA button for every known key; 0 = only the
# generic send/learn text boxes (buttons can multiply as you learn remotes).
IR_EXPOSE_KEY_BUTTONS=1
# Max times a single send request may repeat a key (safety clamp).
IR_SEND_REPEAT_CAP=20
# Where learned codes are stored (JSON source of truth) and the regenerated
# LIRC RAW config is written. Defaults are fine.
IR_LEARNED_DIR=/var/lib/avr-tv-bridge-ir
IR_LEARNED_CONF_DIR=/etc/lirc/lircd.conf.d
