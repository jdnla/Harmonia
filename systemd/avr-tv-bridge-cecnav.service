[Unit]
Description=CEC D-pad navigation — inject keystrokes from TV CEC remote passthrough
# User service: runs in the graphical session (needs the ydotool socket to
# inject into focused apps). The desktop user is in the `video` group so
# cec-follower can read /dev/cec0 without root.
After=graphical-session.target ydotoold.service
Wants=ydotoold.service
PartOf=graphical-session.target

[Service]
Type=simple
Environment=YDOTOOL_SOCKET=%t/.ydotool_socket
Environment=YDOTOOL_BIN=/usr/local/bin/ydotool
ExecStart=/opt/avr-tv-bridge/venv/bin/python /opt/avr-tv-bridge/src/cec_nav.py
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
