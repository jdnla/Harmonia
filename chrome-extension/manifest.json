{
  "manifest_version": 3,
  "name": "Harmonia D-pad Navigation",
  "version": "1.0.0",
  "description": "Spatial (D-pad) navigation for the media center: arrow keys move an on-screen highlight to the nearest control, Enter activates it. Tuned for Netflix and Sportsnet/TSN.",
  "key": "",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.sportsnet.ca/*",
        "*://*.tsn.ca/*"
      ],
      "js": ["spatial_nav.js"],
      "css": ["highlight.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "*://*.netflix.com/*",
    "*://*.sportsnet.ca/*",
    "*://*.tsn.ca/*"
  ]
}
